# Supabase (server-side only — RLS is deny-all, the browser never connects)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — classification + composer
ANTHROPIC_API_KEY=

# Optional: serp lane (reports itself dark without it)
SERPER_API_KEY=

# Optional: Jina Reader key (keyless mode works at ~20 rpm)
JINA_API_KEY=

# Optional: light access gate password (gate disabled when unset)
GATE_PASSWORD=
